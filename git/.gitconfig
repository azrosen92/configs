# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
	name = Aaron Rosen
	email = azrosen92@gmail.com
	username = azrosen92
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	stat = status
	unstage = reset HEAD --
	last = log -l HEAD
	wip = !"git add -A; git ls-files --deleted -z | xargs -0 git rm; git commit -n -m \"wip\""
	unwip = !"git log -n 1 | grep -q -c wip && git reset HEAD~1"
	fix = commit --amend -C HEAD
	amend = commit --amend
	rb = rebase
	rbc = rebase --continue
	rbs = rebase --skip
	lg = log --name-status --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
	update = !"git co $GIT_MAIN && git pull && git co - && git rebase $GIT_MAIN"
	com = !"git co $GIT_MAIN"
	db = !"git checkout -q $GIT_MAIN && twoMonthsAgo=$(date -v-2m '+%s') && mergedBranches=$(git branch --merged $GIT_MAIN) && git for-each-ref refs/heads/ --format='%(refname:short) %(authordate:unix)' | while read branch timestamp; do [[ \"$branch\" != \"$GIT_MAIN\" && $timestamp -lt $twoMonthsAgo ]] && echo \"$mergedBranches\" | grep -qw \"$branch\" && echo \"Would delete: $branch\"; done"
	rball = machete traverse --fetch --start-from=first-root
[push]
	default = current
[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	preloadindex = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = true
[credential]
	helper = osxkeychain
